{
  "name": "tdai-standard-hook",
  "version": "1.0.2",
  "protocol": "tdai-hook/v1",
  "events": ["SessionStart", "UserPromptSubmit", "Stop"],
  "entrypoint": "tdai-hook.py",
  "fail_open": true,
  "installation": {
    "agent_entrypoint": "AGENT_INSTALL.md",
    "bootstrap": {
      "windows": "bootstrap.ps1",
      "ubuntu": "bootstrap.sh",
      "macos": "bootstrap.sh"
    },
    "platform_docs": {
      "windows": "docs/platforms/windows.md",
      "ubuntu": "docs/platforms/ubuntu.md",
      "macos": "docs/platforms/macos.md"
    },
    "config_template": "tdai-memory.example.json",
    "requires_secret_input": true
  },
  "adapters": {
    "stdin_json": ["codex", "claude-code", "zcode", "grok", "agy", "deepseek", "harness"],
    "opencode_v2": "adapters/opencode-plugin.ts",
    "native_adapter_required": ["agy", "opencode"]
  }
}
